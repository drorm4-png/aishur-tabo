{
  "name": "aishur-tabo",
  "version": "1.0.0",
  "description": "אישורטאבו - Municipal Approvals System for real estate transactions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "israel",
    "municipalities",
    "real-estate",
    "approvals",
    "poa",
    "power-of-attorney"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.14.0",
    "body-parser": "^1.20.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jspdf": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "octokit": "^5.0.5",
    "pdfkit": "^0.13.0",
    "playwright": "^1.59.1",
    "sql.js": "^1.10.0",
    "twilio": "^5.13.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!node_modules/**",
      "!tests/**",
      "!coverage/**"
    ],
    "setupFilesAfterEnv": [],
    "testTimeout": 30000,
    "verbose": true
  }
}
