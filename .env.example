# ============================================================
# אישורטאבו - Municipal Approvals System
# Complete Environment Configuration
# ============================================================

# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
DOMAIN=localhost

# SECURITY & ADMIN
# ============================================================
ADMIN_PASSWORD=your-secure-admin-password-here
SESSION_SECRET=your-secret-key-for-sessions-here
VALIDATE_TWILIO_SIGNATURE=false

# DATABASE CONFIGURATION
# ============================================================
DB_PATH=./data/ashurtabo.db
# Alternative: use MongoDB
# MONGO_URI=mongodb://localhost:27017/aishur-tabo

# EMAIL CONFIGURATION (SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SENDER_EMAIL=noreply@aishur-tabo.co.il
ADMIN_EMAIL=admin@aishur-tabo.co.il

# SMS & WHATSAPP CONFIGURATION (Twilio)
# ============================================================
TWILIO_ACCOUNT_SID=your-account-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# PAYMENT GATEWAY CONFIGURATION
# ============================================================
# Primary: Tranzila
TRANZILA_TERMINAL=your-terminal-id-here
TRANZILA_PASSWORD=your-tranzila-password-here

# Alternative: Cardcom
# CARDCOM_CLIENT_ID=your-client-id-here
# CARDCOM_CLIENT_PASSWORD=your-password-here

# Payment settings
SERVICE_FEE=350
PAYMENT_TIMEOUT_MINUTES=30

# CORS & SECURITY
# ============================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_MAX=50

# FILE UPLOAD
# ============================================================
MAX_FILE_SIZE=10485760
MAX_FILES_PER_ORDER=5

# NOTIFICATIONS
# ============================================================
ENABLE_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_WHATSAPP_NOTIFICATIONS=false
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=5000

# ORDER CONFIGURATION
# ============================================================
ORDER_EXPIRY_DAYS=30

# MUNICIPALITY API (if applicable)
# ============================================================
MUNICIPALITY_API_KEY=your-api-key-here
MUNICIPALITY_API_URL=https://api.example.com/municipalities

# LOGGING
# ============================================================
LOG_LEVEL=info

# PLAYWRIGHT AUTOMATION (for order processing)
# ============================================================
# Set to true to enable headless browser automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
